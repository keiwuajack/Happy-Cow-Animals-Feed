# Production database settings
POS_DB_HOST=127.0.0.1
POS_DB_USER=pos_app
POS_DB_PASS=replace-with-a-strong-password
POS_DB_NAME=agrovet_pos

# Private backup storage, outside the public web root
POS_BACKUP_DIR=/var/lib/pos-backups

# Full path to mysqldump on the production server
POS_MYSQLDUMP_PATH=/usr/bin/mysqldump
