Options -Indexes

# Keep application internals, repository metadata, and local data out of the web surface.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:config|includes|backups|\.git|\.codex|\.aws)(?:/|$) - [F,L,NC]
    RewriteRule (^|/)\.(?:env(?:\..*)?|git|codex|aws)(?:/|$) - [F,L,NC]
    RewriteRule \.(?:sql|log|ini|bak|dist)$ - [F,L,NC]
</IfModule>

<FilesMatch "^(?:\.env(?:\..*)?|composer\.(?:json|lock))$">
    Require all denied
</FilesMatch>

# Baseline browser protections. HTTPS should be enabled at the hosting provider.
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# Uncomment only after HTTPS is active for the production domain.
# Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
